{
  "name": "@dayofweek/dcli",
  "version": "1.4.0",
  "description": "CLI for the Day of Week AgTech platform — read data and submit proposals for review",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dcli": "dist/bin/dcli.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bin/dcli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "standalone:build": "node scripts/build-standalone.mjs",
    "standalone:smoke": "node scripts/smoke-standalone.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayofweek/dcli.git"
  },
  "homepage": "https://github.com/dayofweek/dcli#readme",
  "keywords": [
    "dayofweek",
    "agtech",
    "cli",
    "agent",
    "food-supply-chain"
  ]
}
